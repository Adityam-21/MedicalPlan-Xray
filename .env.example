# Backend settings, read by backend/app/config.py from the repo root.

# Required. Prediction logging fails softly (the API still answers) if
# Supabase is unreachable, but the app refuses to start without these set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Optional. Comma-separated origins allowed to call the API from a browser.
# Defaults to localhost:5173 and the Vercel deployment.
# CORS_ORIGINS=https://your-site.vercel.app,http://localhost:5173

# Optional display title.
# API_TITLE=MedicalPlan-Xray API

# No longer used in v2: MODEL_NAME, MODEL_VERSION and API_VERSION.
# Versions now come from the code (API) and plan_model_meta.json (model).
